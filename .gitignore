# OS
.DS_Store

# Swift
.build/
.swiftpm/

# Rust (cross-platform port). Build artifacts go to an off-Drive CARGO_TARGET_DIR
# locally; CI uses the default ./target. Cargo.lock IS committed (the workspace
# ships binaries) for reproducible CI builds.
/target/
**/target/

# Vendored upstream — cloned + built by scripts/setup.sh (doom-ascii is GPL)
doom-ascii/

# Built game binary — produced by scripts/setup.sh
bin/

# Packaged app + DMG — produced by scripts/make-app.sh / make-dmg.sh
dist/

# Runtime
logs/
.savegame/

# Editor
.vscode/
.idea/

# Claude Code local state (agent worktrees, settings)
.claude/

# Mobile shell (shells/mobile)
# --- JS / Metro
shells/mobile/node_modules/
shells/mobile/.expo/
shells/mobile/.metro-cache/

# --- Expo prebuild output (generated; not committed)
shells/mobile/ios/
shells/mobile/android/

# --- Built Rust native libraries (produced by scripts/build-mobile-*.sh)
shells/mobile/modules/aa-engine/ios/AaEngine.xcframework/
shells/mobile/modules/aa-engine/android/src/main/jniLibs/

# --- CocoaPods (generated by pod install inside the prebuild ios/ dir)
shells/mobile/Pods/
shells/mobile/Podfile.lock
