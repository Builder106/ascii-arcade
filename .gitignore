# OS
.DS_Store

# Swift
.build/
.swiftpm/

# Rust (cross-platform port). Build artifacts go to an off-Drive CARGO_TARGET_DIR
# locally; CI uses the default ./target. Cargo.lock IS committed (the workspace
# ships binaries) for reproducible CI builds.
/target/
**/target/

# Vendored upstream — cloned + built by scripts/setup.sh (doom-ascii is GPL)
doom-ascii/

# Built game binary — produced by scripts/setup.sh
bin/

# Packaged app + DMG — produced by scripts/make-app.sh / make-dmg.sh
dist/

# Runtime
logs/
.savegame/

# Editor
.vscode/
.idea/

# Claude Code local state (agent worktrees, settings)
.claude/

# Native iOS shell (shells/ios)
# --- Built Rust native library (produced by scripts/build-ios.sh)
shells/ios/Frameworks/AaEngine.xcframework/

# --- Xcode per-developer state (regenerated locally, not shared)
xcuserdata/
*.xcuserstate

# Native Android shell (shells/android)
# --- gradlew, gradlew.bat, and gradle/wrapper/ ARE committed (standard Gradle
# convention: any clone can build without a preinstalled Gradle) — only the
# cache/output dirs and per-developer local.properties are ignored here.
shells/android/.gradle/
shells/android/app/build/
shells/android/build/
shells/android/local.properties
shells/android/.idea/
shells/android/*.iml

# --- Built Rust native library (produced by scripts/build-android.sh)
shells/android/app/src/main/jniLibs/

# --- Built browser engine (produced by scripts/build-wasm.sh)
# Regenerated from crates/aa-wasm; the Pages workflow builds it on deploy, so
# the live site always has a fresh copy. Not carried in day-to-day history.
site/pkg/

# --- Built doom-wasm (produced by scripts/build-doom-wasm.sh)
# Same pattern as site/pkg/ — regenerated from patches/doom-wasm/, not
# carried in day-to-day history.
site/doom-wasm/
