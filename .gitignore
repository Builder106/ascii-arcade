# OS
.DS_Store

# Swift
.build/
.swiftpm/

# Rust (cross-platform port). Build artifacts go to an off-Drive CARGO_TARGET_DIR
# locally; CI uses the default ./target. Cargo.lock IS committed (the workspace
# ships binaries) for reproducible CI builds.
/target/
**/target/

# Vendored upstream — cloned + built by scripts/setup.sh (doom-ascii is GPL)
doom-ascii/

# Built game binary — produced by scripts/setup.sh
bin/

# Packaged app + DMG — produced by scripts/make-app.sh / make-dmg.sh
dist/

# Runtime
logs/
.savegame/

# Editor
.vscode/
.idea/

# Claude Code local state (agent worktrees, settings)
.claude/

# Native iOS shell (shells/ios)
# --- Built Rust native library (produced by scripts/build-ios.sh)
shells/ios/Frameworks/AaEngine.xcframework/

# --- Xcode per-developer state (regenerated locally, not shared)
xcuserdata/
*.xcuserstate
