<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@style/Theme.AsciiArcade">

        <activity
            android:name=".PreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.AsciiArcade">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
        BIND_WALLPAPER is a signature-level permission only the OS holds; it
        is declared here (restricting who can bind to this service) and is
        NOT a <uses-permission> the app requests.
        -->
        <service
            android:name=".wallpaper.AaWallpaperService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>
    </application>
</manifest>
